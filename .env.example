# Copy this file to .env and replace the placeholder values:
#   cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL (Docker) ---
POSTGRES_DB=finance_tracker
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me

# Host port for PostgreSQL (use another, e.g. 5433, if 5432 is already taken)
DB_PORT=5432

# --- Backend (used from issue #3) ---
# Keep the port in DB_URL equal to DB_PORT, and DB_USERNAME/DB_PASSWORD equal to POSTGRES_USER/POSTGRES_PASSWORD
DB_URL=jdbc:postgresql://localhost:5432/finance_tracker
DB_USERNAME=finance
DB_PASSWORD=change-me
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
